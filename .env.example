DATABASE_URL="file:./prisma/dev.db"
# JWT signing secret. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-random-long-string"

# Set to "true" to allow public registration (new DIRECTOR accounts)
REGISTRATION_ENABLED="false"

# Optional: override default admin credentials
ADMIN_USERNAME=""
ADMIN_PASSWORD="change-me"

# Public base URL of the app (used for email links and OAuth redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "true" only if the app runs behind a trusted reverse proxy
TRUST_PROXY="false"

# Google OAuth — Where to put your Google API credentials:
# 1) Go to https://console.cloud.google.com/apis/credentials
# 2) Create OAuth 2.0 Client ID (Application type: Web application)
# 3) Add Authorized redirect URI:  <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
#    e.g. http://localhost:3000/api/auth/google/callback  and  https://yourdomain.com/api/auth/google/callback
# 4) Copy the values below:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email verification (Gmail SMTP)
# GMAIL_USER: the Gmail address that sends verification emails
# GMAIL_APP_PASSWORD: an App Password generated at https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
